# Formspree form IDs. Create forms at https://formspree.io with the club
# Gmail, then copy the ID from the endpoint URL (formspree.io/f/<THIS>).
#
# Safe to expose: these are the POST targets of forms on public pages.
# Spam control is the honeypot field plus Formspree's own filtering.
#
# If unset, the forms fall back to a mailto: link rather than silently
# discarding submissions. If only the contact ID is set, the volunteer form
# reuses it (submissions stay distinguishable by subject line).
NEXT_PUBLIC_FORMSPREE_ID=
NEXT_PUBLIC_FORMSPREE_VOLUNTEER_ID=
