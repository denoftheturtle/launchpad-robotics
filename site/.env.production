# Formspree endpoint for the contact and volunteer forms.
#
# Committed deliberately: NEXT_PUBLIC_ vars are baked into the client bundle,
# and a Formspree form ID is public by design -- it is the POST target of a
# form on a public page. Committing it means the site builds correctly on any
# host without someone remembering to set a dashboard variable.
NEXT_PUBLIC_FORMSPREE_ID=xkjojpow
