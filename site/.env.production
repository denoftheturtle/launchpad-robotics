# Formspree endpoints. Committed deliberately: NEXT_PUBLIC_ vars are baked
# into the client bundle, and a Formspree form ID is public by design -- it is
# the POST target of a form on a public page. Committing them means the site
# builds correctly on any host without depending on a dashboard setting.
NEXT_PUBLIC_FORMSPREE_ID=xkjojpow
NEXT_PUBLIC_FORMSPREE_VOLUNTEER_ID=xnpjpojd
